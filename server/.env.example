# Скопируйте в .env (НЕ КОММИТИТЬ)
BOT_TOKEN=put_your_telegram_bot_token_here
ADMIN_PASSWORD=put_admin_password_here
PORT=3000

# === GitHub-хранилище для публичного каталога ===
# Все три переменные обязательны для синхронизации с GitHub.
# PAT нужен с правом записи в Contents целевого репо.
# Classic token: scope `repo`. Fine-grained: Contents = Read/Write на нужный репо.
GITHUB_TOKEN=ghp_xxx_your_personal_access_token
GITHUB_OWNER=Husan1405
GITHUB_REPO=yalova-realty
GITHUB_BRANCH=main

# Только для прода на Render/Railway:
# BASE_URL=https://your-service.onrender.com
# WEBHOOK_SECRET=any_random_string
